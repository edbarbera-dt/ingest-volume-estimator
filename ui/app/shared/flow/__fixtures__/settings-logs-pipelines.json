  "scope": "environment",
  "summary": "AstroShop PaymentService",
  "value": {
   "costAllocation": {
    "processors": []
   },
   "customId": "pipeline_AstroShop_PaymentService_7673",
   "dataExtraction": {
    "processors": [
     {
      "bizevent": {
       "eventProvider": {
        "field": {
         "sourceFieldName": "astroshop"
        },
        "type": "field"
       },
       "eventType": {
        "field": {
         "sourceFieldName": "astroshop.paymentservice.transaction.complete"
        },
        "type": "field"
       },
       "fieldExtraction": {
        "type": "includeAll"
       }
      },
      "description": "PaymentService Transaction",
      "enabled": true,
      "id": "processor_PaymentService_Transaction_2896",
      "matcher": "matchesValue(content,\"Transaction complete.\") and isNotNull(payment.amount) and isNotNull(payment.transactionid)",
      "type": "bizevent"
     }
    ]
   },
   "davis": {
    "processors": [
     {
      "davis": {
       "properties": [
        {
         "key": "event.type",
         "value": "ERROR_EVENT"
        },
        {
         "key": "event.name",
         "value": "PaymentService Fail Feature Flag Enabled\n"
        },
        {
         "key": "event.description",
         "value": "Generate an error when calling the charge method."
        },
        {
         "key": "dt.davis.is_rootcause_relevant\t",
         "value": "true"
        },
        {
         "key": "dt.davis.is_merging_allowed\t",
         "value": "true"
        },
        {
         "key": "dt.source_entity\t",
         "value": "{dt.entity.cloud_application}"
        }
       ]
      },
      "description": "PaymentService Fail Feature Flag Enabled",
      "enabled": true,
      "id": "processor_PaymentService_Fail_Feature_Flag_Enabled_8013",
      "matcher": "matchesValue(status,\"WARN\") and matchesValue(message,\"PaymentService Fail Feature Flag Enabled\") and isNotNull(dt.entity.cloud_application)",
      "type": "davis"
     }
    ]
   },
   "displayName": "AstroShop PaymentService",
   "metadataList": [],
   "metricExtraction": {
    "processors": [
     {
      "counterMetric": {
       "dimensions": [
        {
         "extractionType": "field",
         "sourceFieldName": "k8s.namespace.name"
        },
        {
         "extractionType": "field",
         "sourceFieldName": "k8s.workload.name"
        },
        {
         "extractionType": "field",
         "sourceFieldName": "dt.entity.process_group"
        },
        {
         "extractionType": "field",
         "sourceFieldName": "dt.entity.cloud_application"
        }
       ],
       "metricKey": "log.astroshop.paymentservice.failure"
      },
      "description": "PaymentService Failure",
      "enabled": true,
      "id": "processor_PaymentService_Failure_3821",
      "matcher": "matchesValue(status,\"WARN\") and matchesValue(message,\"PaymentService Fail Feature Flag Enabled\") and isNotNull(dt.entity.cloud_application)",
      "type": "counterMetric"
     },
     {
      "description": "PaymentService Transaction",
      "enabled": true,
      "id": "processor_PaymentService_Transaction_3987",
      "matcher": "matchesValue(k8s.container.name,\"paymentservice\") and isNotNull(app.payment.cardType) and isNotNull(app.payment.amount) and isNotNull(app.payment.currencyCode) and isNotNull(app.payment.transactionId)",
      "type": "valueMetric",
      "valueMetric": {
       "dimensions": [
        {
         "destinationFieldName": "cardType",
         "extractionType": "field",
         "sourceFieldName": "app.payment.cardType"
        },
        {
         "destinationFieldName": "currencyCode",
         "extractionType": "field",
         "sourceFieldName": "app.payment.currencyCode"
        }
       ],
       "field": "app.payment.amount",
       "metricKey": "otel.astronomy-shop.app.payment.amount"
      }
     }
    ]
   },
   "processing": {
    "processors": [
     {
      "description": "node_js_001",
      "enabled": true,
      "id": "processor_NodeJS_5126",
      "technology": {
       "technologyId": "node_js_001"
      },
      "type": "technology"
     },
     {
      "description": "Parse Content",
      "dql": {
       "script": "parse content, \"JSON:json_content\"\n| fieldsAdd content = json_content\n| fieldsFlatten content, depth: 3"
      },
      "enabled": true,
      "id": "processor_Parse_Content_8949",
      "matcher": "isNotNull(log.raw_level) and loglevel != \"NONE\" and isNotNull(message)",
      "type": "dql"
     },
     {
      "description": "Message to Content",
      "dql": {
       "script": "fieldsRemove content\n| fieldsAdd content = message"
      },
      "enabled": true,
      "id": "processor_Message_to_Content_4052",
      "matcher": "isNotNull(log.raw_level) and loglevel != \"NONE\" and isNotNull(message) and isNotNull(json_content)",
      "type": "dql"
     },
     {
      "description": "Transaction Fields",
      "dql": {
       "script": "fieldsAdd payment.amount = content.amount.units.low\n| fieldsAdd payment.transactionid = content.transactionId\n| fieldsAdd payment.currencycode = content.amount.currencyCode\n| fieldsAdd payment.cardtype = content.cardType\n| fieldsAdd payment.lastfourdigits = content.lastFourDigits"
      },
      "enabled": true,
      "id": "processor_Transaction_Fields_6213",
      "matcher": "matchesValue(content,\"Transaction complete.\") and isNotNull(content.amount.units.low) and isNotNull(content.transactionId)",
      "type": "dql"
     },
     {
      "description": "Mask Sensitive Data",
      "dql": {
       "script": "fieldsAdd maskedcreditcardnumber = hashMd5(content.request.creditCard.creditCardNumber)\n| fieldsRemove content.request.creditCard.creditCardNumber"
      },
      "enabled": true,
      "id": "processor_Mask_Sensitive_Data_3061",
      "matcher": "isNotNull(content.request.creditCard.creditCardNumber)",
      "type": "dql"
     },
     {
      "description": "Cleanup Fields",
      "dql": {
       "script": "fieldsRemove \"content.dt.*\", \"content.k8s.*\", \"content.time\",\"content.level\", \"content.process.technology\", \"content.hostname\", \"content.pid\"\n| fieldsRemove \"content.request.creditCard.*\"\n| fieldsRemove json_content"
      },
      "enabled": true,
      "id": "processor_Cleanup_Fields_3928",
      "matcher": "isNotNull(log.raw_level) and loglevel != \"NONE\" and isNotNull(message) and isNotNull(json_content) and isNotNull(content)",
      "type": "dql"
     }
    ]
   },
   "productAllocation": {
    "processors": []
   },
   "securityContext": {
    "processors": []
   },
   "storage": {
    "processors": [
     {
      "bucketAssignment": {
       "bucketName": "observe_and_troubleshoot_apps_95_days"
      },
      "description": "Observe and Troubleshoot Apps Bucket",
      "enabled": true,
      "id": "processor_Observe_and_Troubleshoot_Apps_Bucket_7321",
      "matcher": "matchesValue(status,\"INFO\") or matchesValue(status,\"WARN\") or matchesValue(status,\"ERROR\")",
      "type": "bucketAssignment"
     },
     {
      "bucketAssignment": {
       "bucketName": "log_management_analytics_7_days"
      },
      "description": "Log Management and Analytics Bucket",
      "enabled": true,
      "id": "processor_Log_Management_and_Analytics_Bucket_6531",
      "matcher": "matchesValue(status,\"NONE\")",
      "type": "bucketAssignment"
     }
    ]
   }
  }
